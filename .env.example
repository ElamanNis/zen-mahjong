# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# STRIPE: Required for Pro Access upgrades.
STRIPE_SECRET_KEY="YOUR_STRIPE_SECRET_KEY"
STRIPE_PRO_PRICE_ID="YOUR_STRIPE_PRO_PRICE_ID"
NEXT_PUBLIC_STRIPE_PAYMENT_LINK="YOUR_STRIPE_PAYMENT_LINK"

# GROQ_API_KEY: Required for Groq AI API calls (Llama 3).
GROQ_API_KEY="YOUR_GROQ_API_KEY"

# CLERK_SECRET_KEY: Required for Clerk Authentication.
CLERK_SECRET_KEY="YOUR_CLERK_SECRET_KEY"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="YOUR_CLERK_PUBLISHABLE_KEY"

# SUPABASE: Required for database and leaderboard.
NEXT_PUBLIC_SUPABASE_URL="YOUR_SUPABASE_URL"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
